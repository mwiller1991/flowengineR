Package: flowengineR
Type: Package
Title: Modular Framework for Fair and Reproducible Workflow Design
Version: 1.1.0
Authors@R: c(
    person("Maximilian", "Willer", email = "willer.maximilian@googlemail.com",
           role = c("aut", "cre", "cph"),
           comment = c(ORCID = "0009-0003-7054-1937")),
    person("Peter", "Ruckdeschel", email = "peter.ruckdeschel@uni-oldenburg.de",
           role = c("ctb", "cph"),
